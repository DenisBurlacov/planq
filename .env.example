# =============================================================================
# PLANQ — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to git — it's in .gitignore
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=planq
POSTGRES_PASSWORD=planq_secret
POSTGRES_DB=planq_db
POSTGRES_PORT=5432

# --- JWT Authentication ---
# Secrets must be at least 32 characters. Change these in production!
JWT_ACCESS_SECRET=your_access_secret_min_32_chars_change_me
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars_change_me
# Token expiration (default: 15m access, 7d refresh)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Grafana (optional, only for --profile monitoring) ---
# Changed from 3100 to 3200 to avoid conflict with Loki (port 3100)
GRAFANA_PORT=3200
GRAFANA_ADMIN_PASSWORD=admin

# --- Loki (optional, only for --profile monitoring) ---
LOKI_PORT=3100

# --- Reset endpoint secret token ---
# Used in tests: POST /api/test/reset
RESET_TOKEN=super_secret_reset_token_change_in_production
