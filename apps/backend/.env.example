# =============================================================================
# PLANQ Backend — Environment Variables
# Copy this file to .env and adjust values for your environment
# =============================================================================

# --- Server ---
PORT=4000                          # Express server port
NODE_ENV=development               # development | test | production

# --- Database ---
# Must match POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB from root .env
DATABASE_URL=postgresql://planq:planq_secret@localhost:5432/planq_db

# --- JWT Authentication ---
# Secrets must be at least 32 characters. Change these in production!
JWT_ACCESS_SECRET=your_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
# Token expiration (default: 15m access, 7d refresh)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
# Frontend origin for Access-Control-Allow-Origin header
CORS_ORIGIN=http://localhost:3000

# --- Test Reset Endpoint ---
# Secret token for POST /api/test/reset (used in E2E tests to reset DB state)
# Must match RESET_TOKEN in root .env
RESET_TOKEN=super_secret_reset_token_change_in_production

# --- Rate Limiting ---
# Applied to login/register endpoints to prevent brute-force attacks
# NODE_ENV=test raises the limit to 1000 automatically
RATE_LIMIT_WINDOW_MS=900000        # Window duration in milliseconds (15 minutes)
RATE_LIMIT_MAX_REQUESTS=5          # Max login attempts per window before lockout
